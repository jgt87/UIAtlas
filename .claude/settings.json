{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.secrets/**)",
      "Bash(git stash*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .*)",
      "Bash(git add -A*)",
      "Bash(git add -u*)",
      "Bash(git add --all*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Files/Apps/__CommonShared/agent/hooks/shared-lessons.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node C:/Files/Apps/__CommonShared/agent/hooks/worktree-lessons.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Files/Apps/__CommonShared/agent/hooks/no-shell-edits.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Files/Apps/__CommonShared/agent/hooks/lessons-reminder.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
