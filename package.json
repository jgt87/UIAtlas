{
  "name": "ui-atlas",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "description": "Extract any website's screens, UI elements and design tokens into an ordered, browsable atlas.",
  "bin": {
    "atlas": "bin/atlas.mjs"
  },
  "scripts": {
    "extract": "node bin/atlas.mjs extract",
    "serve": "node bin/atlas.mjs serve",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "node scripts/check-code-size.mjs && node scripts/check-eol.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release": "node scripts/release.mjs --archive --name uiatlas --title \"UI Atlas\"",
    "check:design": "node scripts/check-design-rules.mjs --config scripts/design-check.json",
    "check:rows": "node scripts/check-control-rows.mjs http://127.0.0.1:4391/#/screens http://127.0.0.1:4391/#/tokens --widths 1440,390",
    "hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
