{
  "name": "ui-atlas",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Extract any website's screens, UI elements and design tokens into an ordered, browsable atlas.",
  "bin": {
    "atlas": "bin/atlas.mjs"
  },
  "scripts": {
    "extract": "node bin/atlas.mjs extract",
    "serve": "node bin/atlas.mjs serve",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "node scripts/check-code-size.mjs && node scripts/check-eol.mjs",
    "smoke": "node scripts/smoke.mjs",
    "hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
